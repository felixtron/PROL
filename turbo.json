{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PHASE",
    "DATABASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_DOMAIN",
    "BETTER_AUTH_SECRET",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "ANTHROPIC_API_KEY",
    "ASSEMBLYAI_API_KEY",
    "CRON_SECRET",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_STREAM_API_TOKEN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "WORKSHOP_TIME_ZONE",
    "RESEND_API_KEY",
    "RESEND_DOMAIN",
    "SEED_FORCE",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "UPLOAD_DIR",
    "PRIVATE_UPLOAD_DIR",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "APP_DOMAIN",
    "APP_URL",
    "BRAND_DESCRIPTION",
    "BRAND_NAME",
    "BRAND_TAGLINE",
    "DEFAULT_TENANT_SLUG",
    "EMAIL_FROM_NAME",
    "EMAIL_REPLY_TO",
    "POWERED_BY_ENABLED",
    "POWERED_BY_NAME",
    "POWERED_BY_URL",
    "R2_KEY_PREFIX",
    "SUPPORT_EMAIL"
  ]
}
