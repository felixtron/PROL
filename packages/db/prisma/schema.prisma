// ─────────────────────────────────────────────────────────────────────────────
// PROL — White-label SaaS LMS Platform
// Prisma Schema (PostgreSQL)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAUSED
  CHURNED
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
  SUPER_ADMIN
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  MULTI
  DOWNLOAD
}

enum VideoProvider {
  CLOUDFLARE
  VIMEO_URL
  VIMEO_UPLOAD
  YOUTUBE
}

enum InteractiveStopType {
  QUESTION
  REFLECTION
  EXERCISE
  POLL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REFUNDED
  SUSPENDED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentMethod {
  CARD
  OXXO
  SPEI
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum WorkshopType {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum WorkshopPrerequisite {
  NONE
  MODULE_STARTED
  MODULE_COMPLETED
}

enum WorkshopStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  NO_SHOW
}

/// A quién va dirigida una sesión de asesoría: a toda una empresa (la ven
/// todos sus miembros) o a una lista concreta de usuarios registrados.
enum AdvisoryAudience {
  COMPANY
  USERS
}

enum AdvisorySessionStatus {
  /// Borrador: sólo la ve su autor. No notifica y no aparece en el panel del
  /// cliente hasta que se publica.
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EvaluationSectionType {
  INTERNAL
  EXTERNAL
}

enum EvaluationAnswerValue {
  POSITIVE
  PARTIAL // Diagnóstico — "Parcialmente". Inválido para DAFO.
  NEGATIVE
  NOT_APPLICABLE
}

enum EvaluationQuestionType {
  MULTIPLE_CHOICE
  OPEN_TEXT
  MULTI_FACTOR // Multi-selección F/D/O/A (Partes interesadas).
  MULTI_SELECT // Lista personalizable con multi-selección (opciones en EvaluationQuestion.options).
}

/// Factor DAFO marcable en preguntas MULTI_FACTOR.
enum EvaluationFactor {
  STRENGTH // Fortaleza
  WEAKNESS // Debilidad
  OPPORTUNITY // Oportunidad
  THREAT // Amenaza
}

enum EvaluationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Tipo de evaluación: define qué opciones de respuesta y qué reporte usa la plantilla.
/// DAFO         → opción única F/D/O/A según section.type, reporte DAFO (pie + cuadrantes).
/// DIAGNOSTIC   → opción única Sí/Parcialmente/No, reporte de barras GAP.
/// GUIDELINES   → texto abierto, sin gráfico.
/// STAKEHOLDERS → opción múltiple F/D/O/A, sin gráfico.
/// ROLES        → texto abierto, sin gráfico.
enum EvaluationKind {
  DAFO
  DIAGNOSTIC
  GUIDELINES
  STAKEHOLDERS
  ROLES
}

enum NotificationType {
  ENROLLMENT
  PAYMENT
  COURSE_UPDATE
  WORKSHOP
  CERTIFICATE
  SYSTEM
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// Diseño del PDF que se usa al imprimir el diploma de un curso.
/// Se elige por curso; si el curso no define ninguno, el route cae al
/// criterio histórico basado en el tenant (ver certificate-templates).
enum CertificateTemplate {
  IBIZA
  CLASSIC
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AIJobType {
  COURSE_OUTLINE
  VIDEO_TRANSCRIPTION
  LESSON_CONTENT
  COURSE_ENRICHMENT
  DRAFT_REFINEMENT
  LESSON_REGENERATION
  MODULE_REGENERATION
  COHERENCE_CHECK
}

enum CourseDraftStatus {
  BRIEFING
  REFINING
  GENERATING
  READY
  PUBLISHED
  ABANDONED
}

/// Estado de la PLANTILLA de encuesta (el cuestionario en si). No decide si
/// se aceptan respuestas: eso lo decide la ventana del lanzamiento
/// (`SurveyCampaign`). DRAFT = en edicion, PUBLISHED = lista para lanzarse,
/// ARCHIVED = retirada del catalogo.
enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SurveyQuestionType {
  /// Estrellas 1-5.
  RATING_STARS
  /// Opcion multiple SIN orden: aporta distribucion, no puntua.
  MULTIPLE_CHOICE
  /// Escala con etiquetas ORDENADAS de mejor a peor
  /// (p.ej. Excelente / Bueno / Regular / Deficiente). Puntua de 100 a 0
  /// repartido en partes iguales, asi que sirve para el indice igual que las
  /// estrellas pero conservando el vocabulario del formulario original.
  SCALE_LABELED
  /// Texto libre. Nunca puntua y sus respuestas son individuales, asi que
  /// solo las ve el administrador: no salen en el consolidado publicado.
  OPEN_TEXT
}

/// Estado de un lanzamiento (envio) de encuesta.
enum SurveyCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

/// A quien se dirige un lanzamiento dentro de una empresa.
enum SurveyAudienceKind {
  /// Solo el usuario lider de la empresa.
  COMPANY_LEADER
  /// Uno o varios usuarios elegidos a mano.
  SPECIFIC_USERS
  /// Todos los usuarios enrolados de la empresa.
  COMPANY_ALL
}

/// Estado de cada destinatario dentro de un lanzamiento.
enum SurveyRecipientStatus {
  PENDING
  SENT
  RESPONDED
  EXPIRED
  REVOKED
}

/// Disparador automatico configurado en la plantilla.
enum SurveyTrigger {
  MANUAL
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
}

/// Hasta donde llega el resultado consolidado una vez que el administrador
/// aprueba su publicacion. NONE = solo el administrador lo ve.
enum SurveyResultsAudience {
  NONE
  LEADER
  PARTICIPANTS
}

enum DraftOperationType {
  BRIEFING_SUBMITTED
  REFINEMENT_GENERATED
  REFINEMENT_EDITED
  OUTLINE_GENERATED
  OUTLINE_ACCEPTED
  LESSON_REGENERATED
  MODULE_REGENERATED
  LESSON_SPLIT
  LESSONS_MERGED
  COHERENCE_CHECKED
  MANUAL_EDIT
}

/// Cómo se imparte un curso, a efectos del periodo que se imprime en el
/// DC-3. La STPS exige un periodo real de ejecución ("De … a …"), y ese
/// dato no se puede sacar de la fecha en que se creó el curso.
///
///   ONLINE — en línea / pregrabado. El periodo es la ventana real del
///            alumno: de su inscripción a la fecha en que completó. Es lo
///            único que consta como impartición efectiva.
///   LIVE   — en vivo (presencial o virtual). El periodo lo fija la
///            edición/evento al que asistió el alumno, porque la fecha
///            programada y la real suelen diferir.
enum Dc3DeliveryMode {
  ONLINE
  LIVE
}

enum Dc3Status {
  ACTIVE
  CANCELLED
}

/// Asientos del historial de un DC-3. `ISSUED` es el acto de emitir (una
/// sola vez); `PRINTED` es cada copia que se descarga después — la
/// primera y las reimpresiones se registran igual, y lo que las
/// distingue es su posición en el historial.
enum Dc3PrintAction {
  ISSUED
  PRINTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// The creator's branded academy — top-level tenant in the multi-tenant model.
/// Resolved via subdomain: {slug}.prol.prosuite.pro or via customDomain.
model Tenant {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  customDomain String? @unique @map("custom_domain")

  // Revenue & billing
  revenueShareRate Float        @default(0.30) @map("revenue_share_rate")
  trialEndsAt      DateTime?    @map("trial_ends_at")
  status           TenantStatus @default(TRIAL)
  stripeAccountId  String?      @map("stripe_account_id")

  // Branding
  logo         String?
  primaryColor String  @default("#6366f1") @map("primary_color")
  accentColor  String  @default("#f59e0b") @map("accent_color")
  favicon      String?
  customCss    String? @map("custom_css")

  // Contact
  contactEmail String? @map("contact_email")
  phone        String?
  socialLinks  Json?   @map("social_links")

  // Feature flags
  workshopsEnabled   Boolean @default(false) @map("workshops_enabled")
  aiEnabled          Boolean @default(false) @map("ai_enabled")
  companiesEnabled   Boolean @default(true) @map("companies_enabled")
  evaluationsEnabled Boolean @default(false) @map("evaluations_enabled")
  surveysEnabled     Boolean @default(false) @map("surveys_enabled")
  // Consultoría Online (módulo de sesiones de asesoría). Default `true`
  // porque el módulo ya estaba disponible para todos los tenants antes de
  // existir el flag: así activarlo no cambia lo que ven hoy.
  advisoryEnabled    Boolean @default(true) @map("advisory_enabled")

  // AI billing — plan and credit balance (prices defined later, structure ready)
  aiPlan             String    @default("none") @map("ai_plan")
  aiCreditsBalance   Int       @default(0) @map("ai_credits_balance")
  aiMonthlyAllotment Int       @default(0) @map("ai_monthly_allotment")
  aiAllotmentResetAt DateTime? @map("ai_allotment_reset_at")

  // Certificate folio prefix (e.g. "PROL", "ACME", etc.)
  certificatePrefix String @default("PROL") @map("certificate_prefix")

  // Google Meet integration. The tenant designates ONE connected Google
  // account (an admin who linked Google via Better Auth) as the "host"
  // account: every virtual workshop created in this tenant gets its Meet
  // link generated from that account's calendar. We only store a pointer to
  // the user — the OAuth tokens live in the `accounts` table, managed and
  // refreshed by Better Auth. `googleCalendarEmail` is a display-only copy
  // so the settings UI can show which account is connected without an extra
  // round-trip to Google.
  googleCalendarUserId String? @map("google_calendar_user_id")
  googleCalendarEmail  String? @map("google_calendar_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users               User[]
  courses             Course[]
  enrollments         Enrollment[]
  payments            CoursePayment[]
  workshops           Workshop[]
  advisorySessions    AdvisorySession[]
  certificates        Certificate[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  aiGenerationJobs    AIGenerationJob[]
  companies           Company[]
  certificateCounters CertificateCounter[]
  courseDrafts        CourseDraft[]
  aiCreditsLedger     AICreditsLedger[]
  evaluations         Evaluation[]
  surveys             Survey[]
  surveyCampaigns     SurveyCampaign[]
  trainingAgents      TrainingAgent[]
  dc3Certificates     Dc3Certificate[]
  dc3Counters         Dc3Counter[]
  dc3CourseEditions   Dc3CourseEdition[]

  @@index([slug])
  @@index([status])
  @@index([customDomain])
  @@map("tenants")
}

/// All platform users: students, professors, tenant admins, and super admins.
/// Authenticated via Better Auth. SUPER_ADMIN users have tenantId = null.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String?
  image         String?
  avatar        String?
  role          UserRole @default(STUDENT)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  stripeCustomerId String? @unique @map("stripe_customer_id")

  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  mustResetPassword   Boolean   @default(false) @map("must_reset_password")
  disabledAt          DateTime? @map("disabled_at")
  lastLoginAt         DateTime? @map("last_login_at")

  // ── DC-3: datos del trabajador ────────────────────────────────────
  // Los llena el propio usuario (bloque amarillo del formato oficial).
  // Viven en el usuario y no en la inscripción porque son datos de la
  // persona: se capturan una vez y sirven para todos sus DC-3.
  //
  // `dc3FullName` existe aparte de `name` porque la STPS pide el orden
  // "apellido paterno, materno y nombre(s)", que no es como la gente
  // escribe su nombre en el perfil. Si está vacío se cae a `name`.
  dc3FullName       String?   @map("dc3_full_name")
  curp              String?   @map("curp")
  /// Clave de área/subárea del Catálogo Nacional de Ocupaciones (p. ej. "04.4").
  dc3OccupationCode String?   @map("dc3_occupation_code")
  /// Puesto en la empresa. Opcional en el formato oficial.
  dc3JobPosition    String?   @map("dc3_job_position")
  dc3ConfirmedAt    DateTime? @map("dc3_confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sessions                    Session[]
  accounts                    Account[]
  taughtCourses               Course[]                     @relation("CourseProfessor")
  enrollments                 Enrollment[]
  payments                    CoursePayment[]
  workshops                   Workshop[]                   @relation("WorkshopProfessor")
  advisorySessionsGiven       AdvisorySession[]            @relation("AdvisorySessionAdvisor")
  advisorySessionsInvited     AdvisorySessionParticipant[] @relation("AdvisorySessionParticipants")
  workshopBookings            WorkshopBooking[]
  workshopAttendances         WorkshopAttendance[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  aiGenerationJobs            AIGenerationJob[]
  invitationsSent             CompanyInvitation[]          @relation("InvitationsSent")
  assignmentsMade             CompanyCourseAssignment[]    @relation("AssignmentsMade")
  courseDrafts                CourseDraft[]
  companyLed                  Company?                     @relation("CompanyLeader")
  evaluationsCreated          Evaluation[]                 @relation("EvaluationAuthor")
  evaluationAssignmentsMade   EvaluationAssignment[]       @relation("EvaluationAssignedBy")
  evaluationParticipations    EvaluationParticipant[]      @relation("EvaluationParticipantUser")
  evaluationParticipantsAdded EvaluationParticipant[]      @relation("EvaluationParticipantAddedBy")
  evaluationSubmissions       EvaluationSubmission[]
  surveysCreated              Survey[]                     @relation("SurveysCreated")
  surveyCampaignsCreated      SurveyCampaign[]             @relation("SurveyCampaignsCreated")
  surveyResultsPublished      SurveyCampaign[]             @relation("SurveyResultsPublisher")
  surveyInvitations           SurveyRecipient[]            @relation("SurveyRecipientUser")
  courseCollaborations        CourseCollaborator[]         @relation("CourseCollaboratorUser")
  courseCollaboratorsAdded    CourseCollaborator[]         @relation("CourseCollaboratorAddedBy")
  companiesDc3Confirmed       Company[]                    @relation("CompanyDc3ConfirmedBy")
  dc3CertificatesIssued       Dc3Certificate[]             @relation("Dc3IssuedBy")
  dc3PrintLogs                Dc3PrintLog[]                @relation("Dc3PrintedBy")

  @@index([tenantId])
  @@index([companyId])
  @@index([email])
  @@index([role])
  @@map("users")
}

/// Better Auth session — tracks active login sessions per user.
model Session {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// Better Auth account — links OAuth providers and credentials to a user.
model Account {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

/// Better Auth verification — stores email verification and password reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

/// A course offered within a tenant's academy.
/// Scoped by tenantId + slug for clean URLs.
model Course {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  professorId String @map("professor_id")
  professor   User   @relation("CourseProfessor", fields: [professorId], references: [id], onDelete: Restrict)

  title           String
  slug            String
  description     String?
  thumbnail       String?
  previewVideoUrl String? @map("preview_video_url")

  priceInCents Int    @map("price_in_cents")
  currency     String @default("MXN")

  status      CourseStatus @default(DRAFT)
  publishedAt DateTime?    @map("published_at")

  category String?
  tags     Json?

  totalDurationMinutes Int @default(0) @map("total_duration_minutes")
  totalLessons         Int @default(0) @map("total_lessons")

  // ── Diploma ───────────────────────────────────────────────────────
  // Configuración del diploma que se emite al completar el curso,
  // editable por el profesor responsable. Todos estos campos se
  // snapshotean en Certificate.metadata al emitir, así que editarlos
  // nunca reescribe diplomas ya entregados.
  //
  // Plantilla del PDF. null = decidir por tenant (comportamiento previo
  // a que esto fuera configurable), para no cambiar el diseño de los
  // cursos que ya existían.
  certificateTemplate    CertificateTemplate? @map("certificate_template")
  // Código o norma que encabeza el diploma, p. ej. "ISO 27001".
  certificateCode        String?              @map("certificate_code")
  // Nombre de la formación tal y como debe imprimirse. Si está vacío se
  // usa el título del curso, que suele traer el código pegado delante.
  certificateCourseName  String?              @map("certificate_course_name")
  // Párrafo que aparece debajo del nombre de la formación. Si está
  // vacío, el template usa un fallback genérico.
  certificateDescription String?              @map("certificate_description") @db.Text
  // Quién firma el diploma. Si está vacío firma el tenant.
  certificateSignerName  String?              @map("certificate_signer_name")

  // ── DC-3: datos del programa de capacitación ──────────────────────
  // Bloque naranja del formato oficial. Lo configura el administrador
  // del tenant (Ibiza), no el profesor: el DC-3 es un documento con
  // efectos ante la STPS, no una pieza de marca del curso.
  //
  // `dc3Enabled` es el interruptor: mientras esté apagado el curso no
  // ofrece DC-3 a nadie, aunque los alumnos tengan empresa. Arranca
  // apagado para que activar el módulo no empiece a ofrecer constancias
  // en cursos que nunca se diseñaron para acreditarse.
  dc3Enabled          Boolean         @default(false) @map("dc3_enabled")
  /// Nombre del curso tal y como debe imprimirse en el DC-3. Si está
  /// vacío se usa el título del curso.
  dc3CourseName       String?         @map("dc3_course_name")
  /// Clave del Catálogo de Áreas Temáticas de los cursos (1000…9000).
  dc3ThematicAreaCode String?         @map("dc3_thematic_area_code")
  /// Duración en horas. Es un dato declarado, no la suma de los vídeos.
  dc3DurationHours    Int?            @map("dc3_duration_hours")
  dc3DeliveryMode     Dc3DeliveryMode @default(ONLINE) @map("dc3_delivery_mode")
  /// Instructor o tutor que firma el DC-3. Puede no ser el profesor
  /// dueño del curso en la plataforma.
  dc3InstructorName   String?         @map("dc3_instructor_name")

  dc3TrainingAgentId String?        @map("dc3_training_agent_id")
  dc3TrainingAgent   TrainingAgent? @relation(fields: [dc3TrainingAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  modules            Module[]
  enrollments        Enrollment[]
  payments           CoursePayment[]
  workshops          Workshop[]
  companyAssignments CompanyCourseAssignment[]
  collaborators      CourseCollaborator[]
  surveyCampaigns    SurveyCampaign[]          @relation("SurveyCampaignCourse")
  surveyTriggers     Survey[]                  @relation("SurveyTriggerCourse")
  dc3Editions        Dc3CourseEdition[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([professorId])
  @@index([status])
  @@index([tenantId, status])
  @@map("courses")
}

/// Profesor invitado a co-crear un curso que no le pertenece.
///
/// El dueño sigue siendo `Course.professorId` — esta tabla solo suma
/// colaboradores. Un colaborador puede editar el curso, publicarlo y ver a
/// sus alumnos, pero NO puede borrarlo ni transferirlo (eso queda para el
/// dueño y el admin del tenant).
model CourseCollaborator {
  id       String @id @default(cuid())
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("CourseCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Quién lo invitó (el dueño del curso o un admin del tenant).
  addedById String @map("added_by_id")
  addedBy   User   @relation("CourseCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_collaborators")
}

/// A section/module within a course, used to group lessons.
model Module {
  id       String @id @default(cuid())
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Submódulos: un módulo puede contener otros módulos (1 nivel de
  // anidamiento). El submódulo conserva su `courseId` (= el del padre) para
  // que toda la navegación `lesson → module → course` siga funcionando sin
  // cambios. `parentModuleId = null` ⇒ módulo de nivel superior (el caso de
  // todos los módulos existentes tras la migración aditiva).
  parentModuleId String?  @map("parent_module_id")
  parentModule   Module?  @relation("SubModules", fields: [parentModuleId], references: [id], onDelete: Cascade)
  submodules     Module[] @relation("SubModules")

  title       String
  description String?
  position    Int
  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  lessons   Lesson[]
  workshops Workshop[]

  @@index([courseId])
  @@index([courseId, position])
  @@index([parentModuleId])
  @@map("modules")
}

/// An individual lesson within a module. Can be video, text, quiz, or assignment.
model Lesson {
  id       String @id @default(cuid())
  moduleId String @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  description String?
  position    Int
  type        LessonType @default(VIDEO)

  videoUrl             String?        @map("video_url")
  videoProvider        VideoProvider? @default(CLOUDFLARE) @map("video_provider")
  videoRawUrl          String?        @map("video_raw_url")
  videoHash            String?        @map("video_hash")
  videoDurationSeconds Int?           @map("video_duration_seconds")
  content              Json?

  // AI-generated content
  transcript  Json?   @map("transcript")
  summary     String? @map("summary")
  aiGenerated Boolean @default(false) @map("ai_generated")
  aiStatus    String? @map("ai_status")

  isPublished Boolean @default(false) @map("is_published")
  isFree      Boolean @default(false) @map("is_free")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  interactiveStops      InteractiveStop[]
  quizzes               Quiz[]
  lessonProgresses      LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([moduleId])
  @@index([moduleId, position])
  @@map("lessons")
}

/// A pause point during video playback that presents an interactive element.
model InteractiveStop {
  id       String @id @default(cuid())
  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  timestampSeconds Int                 @map("timestamp_seconds")
  type             InteractiveStopType
  content          Json
  isRequired       Boolean             @default(true) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  responses InteractiveStopResponse[]

  @@index([lessonId])
  @@index([lessonId, timestampSeconds])
  @@map("interactive_stops")
}

/// A quiz attached to a lesson.
model Quiz {
  id       String @id @default(cuid())
  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title        String
  passingScore Int    @default(70) @map("passing_score")
  questions    Json
  timeLimit    Int?   @map("time_limit")
  maxAttempts  Int    @default(3) @map("max_attempts")

  // When true, passing this quiz triggers certificate issuance for the course.
  // Each course should have at most one quiz with isFinalExam=true.
  isFinalExam Boolean @default(false) @map("is_final_exam")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  attempts QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

/// Represents a student's enrollment in a course. Tracks overall progress.
model Enrollment {
  id        String @id @default(cuid())
  studentId String @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status   EnrollmentStatus @default(ACTIVE)
  progress Float            @default(0)

  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  // Edición/evento en el que este alumno recibió un curso en vivo. De
  // aquí sale el periodo de ejecución del DC-3; para cursos en línea
  // queda null y el periodo lo dan enrolledAt/completedAt.
  dc3EditionId String?           @map("dc3_edition_id")
  dc3Edition   Dc3CourseEdition? @relation(fields: [dc3EditionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  lessonProgresses      LessonProgress[]
  quizAttempts          QuizAttempt[]
  certificate           Certificate?
  dc3Certificate        Dc3Certificate?
  assignmentSubmissions AssignmentSubmission[]

  @@unique([studentId, courseId])
  @@index([tenantId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([dc3EditionId])
  @@map("enrollments")
}

/// Tracks a student's progress through an individual lesson.
model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status               LessonProgressStatus @default(NOT_STARTED)
  videoPositionSeconds Int                  @default(0) @map("video_position_seconds")
  completedAt          DateTime?            @map("completed_at")

  // For MULTI lessons: tracks per-block completion
  // Schema: { videoWatchedSeconds?: number, pdfDownloadedAt?: string, blockProgress?: { [blockId: string]: boolean } }
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  interactiveStopResponses InteractiveStopResponse[]

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progresses")
}

/// A student's response to an interactive stop during video playback.
model InteractiveStopResponse {
  id               String         @id @default(cuid())
  lessonProgressId String         @map("lesson_progress_id")
  lessonProgress   LessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  interactiveStopId String          @map("interactive_stop_id")
  interactiveStop   InteractiveStop @relation(fields: [interactiveStopId], references: [id], onDelete: Cascade)

  response    Json
  isCorrect   Boolean? @map("is_correct")
  respondedAt DateTime @default(now()) @map("responded_at")

  @@index([lessonProgressId])
  @@index([interactiveStopId])
  @@map("interactive_stop_responses")
}

/// A student's attempt at a quiz, storing answers and score.
model QuizAttempt {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  quizId String @map("quiz_id")
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers Json
  score   Int
  passed  Boolean

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([enrollmentId])
  @@index([quizId])
  @@map("quiz_attempts")
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  REVIEWED
  RETURNED
}

/// A student's submission for an ASSIGNMENT-type lesson.
/// The professor configures the assignment via Lesson.content (instructions
/// + optional PDF). Students upload their work as fileUrl + optional notes.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  fileUrl  String? @map("file_url")
  fileName String? @map("file_name")
  fileSize Int?    @map("file_size")
  notes    String?

  status   AssignmentSubmissionStatus @default(SUBMITTED)
  grade    Int?
  feedback String?

  submittedAt DateTime  @default(now()) @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@index([enrollmentId])
  @@index([status])
  @@map("assignment_submissions")
}

/// Payment record for a course purchase via Stripe Connect.
/// Stores revenue share snapshot at the time of payment.
model CoursePayment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId String @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  amount   Int
  currency String @default("MXN")

  revenueShareRate Float @map("revenue_share_rate")
  prolFee          Int   @map("prol_fee")
  creatorReceives  Int   @map("creator_receives")
  stripeFee        Int   @map("stripe_fee")

  stripePaymentId String        @unique @map("stripe_payment_id")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(PENDING)

  // For OXXO/SPEI: URL to the hosted voucher with payment instructions
  voucherUrl       String?   @map("voucher_url")
  voucherExpiresAt DateTime? @map("voucher_expires_at")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([stripePaymentId])
  @@map("course_payments")
}

/// A scheduled workshop session (in-person, virtual, or hybrid).
model Workshop {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  moduleId String? @map("module_id")
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  professorId String @map("professor_id")
  professor   User   @relation("WorkshopProfessor", fields: [professorId], references: [id], onDelete: Restrict)

  title       String
  description String?
  type        WorkshopType @default(IN_PERSON)

  locationName    String? @map("location_name")
  locationAddress String? @map("location_address")
  locationMapUrl  String? @map("location_map_url")
  meetingUrl      String? @map("meeting_url")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  maxAttendees Int @map("max_attendees")
  minAttendees Int @default(3) @map("min_attendees")

  isRequired      Boolean              @default(false) @map("is_required")
  prerequisite    WorkshopPrerequisite @default(NONE)
  cancellationHrs Int                  @default(24) @map("cancellation_hrs")
  recurringRule   String?              @map("recurring_rule")

  // Recurring series: a "parent" workshop is the first occurrence; each
  // additional occurrence is created as a child pointing back to the parent
  // via parentWorkshopId. The frequency is informational and stored on every
  // member of the series (parent + children) for easy filtering.
  parentWorkshopId    String?              @map("parent_workshop_id")
  parentWorkshop      Workshop?            @relation("WorkshopRecurrence", fields: [parentWorkshopId], references: [id], onDelete: Cascade)
  childWorkshops      Workshop[]           @relation("WorkshopRecurrence")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")

  status WorkshopStatus @default(SCHEDULED)

  // Calendar event that generated `meetingUrl` when the Meet link was created
  // automatically. Stored so a future cleanup can update or delete the event;
  // for a recurring series only the parent carries it (one event with an
  // RRULE covers every occurrence, and they all share the same Meet link).
  googleEventId String? @map("google_event_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  bookings        WorkshopBooking[]
  attendances     WorkshopAttendance[]
  surveyCampaigns SurveyCampaign[]     @relation("SurveyCampaignWorkshop")

  @@index([tenantId])
  @@index([courseId])
  @@index([professorId])
  @@index([status])
  @@index([startTime])
  @@index([tenantId, status])
  @@index([parentWorkshopId])
  @@map("workshops")
}

/// A student's booking/reservation for a workshop.
model WorkshopBooking {
  id         String   @id @default(cuid())
  workshopId String   @map("workshop_id")
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  studentId String @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status           BookingStatus @default(CONFIRMED)
  waitlistPosition Int?          @map("waitlist_position")

  bookedAt    DateTime  @default(now()) @map("booked_at")
  cancelledAt DateTime? @map("cancelled_at")

  @@unique([workshopId, studentId])
  @@index([workshopId])
  @@index([studentId])
  @@index([status])
  @@map("workshop_bookings")
}

/// Attendance record for a workshop session (check-in/check-out + feedback).
model WorkshopAttendance {
  id         String   @id @default(cuid())
  workshopId String   @map("workshop_id")
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  studentId String @map("student_id")
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  checkedInAt  DateTime  @map("checked_in_at")
  checkedInBy  String    @map("checked_in_by")
  checkedOutAt DateTime? @map("checked_out_at")

  feedback String?
  rating   Int?

  @@unique([workshopId, studentId])
  @@index([workshopId])
  @@index([studentId])
  @@map("workshop_attendances")
}

/// Sesión de asesoría: una cita del asesor con un cliente.
///
/// Es un módulo aparte de `Workshop` a propósito. Un workshop es una clase
/// con cupo, lista de espera y check-in, colgada de un curso; una asesoría es
/// una cita de consultoría que existe por sí sola. Intentar servir los dos
/// casos con una tabla fue lo que enredó el modelo antes: acá NO hay curso ni
/// módulo, y el acceso lo decide la audiencia (empresa o participantes).
model AdvisorySession {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  advisorId String @map("advisor_id")
  advisor   User   @relation("AdvisorySessionAdvisor", fields: [advisorId], references: [id], onDelete: Restrict)

  title       String
  description String?
  // Se reutiliza `WorkshopType` (presencial/virtual/híbrida) en vez de
  // duplicar un enum idéntico: es la misma modalidad.
  type        WorkshopType @default(VIRTUAL)

  // Audiencia. Con COMPANY se usa `companyId` y la ven todos sus miembros;
  // con USERS se usa la tabla de participantes.
  audience  AdvisoryAudience @default(COMPANY)
  companyId String?          @map("company_id")
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationName    String? @map("location_name")
  locationAddress String? @map("location_address")
  locationMapUrl  String? @map("location_map_url")
  meetingUrl      String? @map("meeting_url")
  googleEventId   String? @map("google_event_id")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  // Serie recurrente: misma mecánica que Workshop — la primera ocurrencia es
  // el padre y las demás apuntan a ella.
  parentSessionId     String?              @map("parent_session_id")
  parentSession       AdvisorySession?     @relation("AdvisorySessionRecurrence", fields: [parentSessionId], references: [id], onDelete: Cascade)
  childSessions       AdvisorySession[]    @relation("AdvisorySessionRecurrence")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")

  status AdvisorySessionStatus @default(SCHEDULED)

  /// Momento en que salió la invitación por correo. Sirve para dos cosas: no
  /// reenviarla en cada edición, y saber si un cambio de horario posterior
  /// amerita avisar de la reprogramación.
  invitedAt DateTime? @map("invited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants    AdvisorySessionParticipant[]
  surveyCampaigns SurveyCampaign[]             @relation("SurveyCampaignAdvisory")

  @@index([tenantId])
  @@index([advisorId])
  @@index([companyId])
  @@index([startTime])
  @@index([status])
  @@index([parentSessionId])
  @@map("advisory_sessions")
}

/// Usuario convocado a una sesión de asesoría dirigida a personas concretas
/// (audiencia USERS).
model AdvisorySessionParticipant {
  id        String          @id @default(cuid())
  sessionId String          @map("session_id")
  session   AdvisorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("AdvisorySessionParticipants", fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now()) @map("added_at")

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("advisory_session_participants")
}

/// Certificate issued upon course completion (passing the final exam with >= 80%).
model Certificate {
  id           String     @id @default(cuid())
  enrollmentId String     @unique @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentName   String @map("student_name")
  courseName    String @map("course_name")
  professorName String @map("professor_name")

  // Sequential public folio: "{prefix}-{year}-{NNNN}" e.g. "PROL-2026-0042"
  folio  String @unique
  // Random hash kept for backwards-compat / private references
  hash   String @unique
  // SHA-256 of the canonical certificate data (anti-forgery, verifiable)
  sha256 String @map("sha256")

  status        CertificateStatus @default(ACTIVE)
  issuedAt      DateTime          @default(now()) @map("issued_at")
  expiresAt     DateTime?         @map("expires_at")
  revokedAt     DateTime?         @map("revoked_at")
  revokedReason String?           @map("revoked_reason")

  // Snapshot of the final exam score that triggered issuance
  finalExamScore Int? @map("final_exam_score")

  pdfUrl   String? @map("pdf_url")
  metadata Json?

  @@index([tenantId])
  @@index([folio])
  @@index([hash])
  @@index([status])
  @@map("certificates")
}

/// Counter for sequential certificate folios per tenant per year.
/// Avoids race conditions when generating folios concurrently.
model CertificateCounter {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year     Int
  lastSeq  Int    @default(0) @map("last_seq")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, year])
  @@map("certificate_counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// DC-3 — Constancia de Competencias o de Habilidades Laborales (STPS)
//
// Documento oficial mexicano, distinto del diploma de la plataforma: lo
// emite el patrón para acreditar ante la STPS que capacitó a un
// trabajador. Por eso sólo existe para alumnos que pertenecen a una
// empresa con patrón registrado, y por eso sus datos vienen de tres
// manos distintas (trabajador, líder de proyecto y administrador), que
// es exactamente como está pintado el formato oficial.
// ─────────────────────────────────────────────────────────────────────────────

/// Agente capacitador externo, tal y como lo pide el formato.
///
/// Es una entidad propia y no un campo de texto en el curso porque una
/// misma consultora imparte muchos cursos y su registro ante la STPS
/// tiene que ser idéntico en todos los DC-3 que firma. También evita
/// asumir que el agente capacitador es el tenant que opera la
/// plataforma: son cosas distintas y con frecuencia son empresas
/// distintas.
model TrainingAgent {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  /// Registro del agente capacitador ante la STPS. Si el curso lo
  /// imparte directamente la Secretaría, aquí va su clave (nota 3).
  stpsRegistry String? @map("stps_registry")
  rfc          String?

  /// Logotipo opcional para el encabezado del DC-3, junto al del patrón:
  /// el formato reserva ese espacio al agente capacitador externo.
  logoUrl String? @map("logo_url")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("training_agents")
}

/// Edición (evento) de impartición de un curso en vivo.
///
/// Existe porque el DC-3 exige el periodo REAL de ejecución y una misma
/// plantilla de curso se imparte muchas veces en fechas distintas.
/// Guardar las fechas en el curso haría que todos los alumnos de todas
/// las generaciones recibieran el mismo periodo, que es falso.
model Dc3CourseEdition {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Etiqueta operativa, p. ej. "Generación marzo 2026 — Monterrey".
  name String

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  /// Sobrescriben lo declarado en el curso cuando esta edición se dio en
  /// otras horas o con otro instructor. Null = usar lo del curso.
  durationHours  Int?    @map("duration_hours")
  instructorName String? @map("instructor_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments Enrollment[]

  @@index([tenantId])
  @@index([courseId])
  @@map("dc3_course_editions")
}

/// Un DC-3 emitido. Todo lo imprimible está congelado aquí: corregir el
/// CURP del trabajador o el RFC del patrón después de emitir NO cambia
/// lo que dice un documento ya entregado, que es justamente lo que la
/// leyenda de responsabilidad le advierte al usuario antes de imprimir.
model Dc3Certificate {
  id String @id @default(cuid())

  enrollmentId String     @unique @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Folio interno de control: "{prefijo}-DC3-{año}-{NNNN}". El formato
  /// oficial no lo pide, pero sin él no hay forma de rastrear una
  /// reimpresión concreta.
  folio  String    @unique
  status Dc3Status @default(ACTIVE)

  // ── Snapshot: datos del trabajador ──────────────────────────────
  workerName      String  @map("worker_name")
  workerCurp      String  @map("worker_curp")
  occupationCode  String  @map("occupation_code")
  occupationLabel String  @map("occupation_label")
  jobPosition     String? @map("job_position")

  // ── Snapshot: datos de la empresa ───────────────────────────────
  employerName   String  @map("employer_name")
  employerRfc    String  @map("employer_rfc")
  legalRepName   String  @map("legal_rep_name")
  workersRepName String? @map("workers_rep_name")

  // ── Snapshot: datos del programa ────────────────────────────────
  courseName            String   @map("course_name")
  durationHours         Int      @map("duration_hours")
  startDate             DateTime @map("start_date") @db.Date
  endDate               DateTime @map("end_date") @db.Date
  thematicAreaCode      String   @map("thematic_area_code")
  thematicAreaLabel     String   @map("thematic_area_label")
  trainingAgentName     String   @map("training_agent_name")
  trainingAgentRegistry String?  @map("training_agent_registry")
  instructorName        String   @map("instructor_name")

  issuedAt   DateTime @default(now()) @map("issued_at")
  issuedById String   @map("issued_by_id")
  issuedBy   User     @relation("Dc3IssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  printCount    Int       @default(0) @map("print_count")
  lastPrintedAt DateTime? @map("last_printed_at")

  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason")

  metadata Json?

  prints Dc3PrintLog[]

  @@index([tenantId])
  @@index([companyId])
  @@index([folio])
  @@index([status])
  @@map("dc3_certificates")
}

/// Historial de emisión y reimpresión. Un DC-3 puede reimprimirse
/// legítimamente (se perdió el papel), pero cada copia que sale tiene
/// que quedar registrada con quién y cuándo.
model Dc3PrintLog {
  id    String         @id @default(cuid())
  dc3Id String         @map("dc3_id")
  dc3   Dc3Certificate @relation(fields: [dc3Id], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("Dc3PrintedBy", fields: [userId], references: [id], onDelete: Cascade)

  action Dc3PrintAction

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([dc3Id])
  @@index([userId])
  @@map("dc3_print_logs")
}

/// Contador de folios DC-3 por tenant y año. Separado del de diplomas a
/// propósito: son dos series de documentos distintas y mezclarlas dejaría
/// huecos en ambas.
model Dc3Counter {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year     Int
  lastSeq  Int    @default(0) @map("last_seq")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, year])
  @@map("dc3_counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// Companies (groups of users within a tenant — e.g. corporate clients)
// ─────────────────────────────────────────────────────────────────────────────

/// A company groups users within a tenant. Used for B2B scenarios where
/// an organization wants to manage its own employees as students.
model Company {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  slug         String
  logo         String?
  contactEmail String? @map("contact_email")
  seatsLimit   Int?    @map("seats_limit")

  // When true, current members can invite new users to the company.
  // When false, only ADMIN/SUPER_ADMIN (and the company leader, if any)
  // can add members.
  allowMemberInvitations Boolean @default(false) @map("allow_member_invitations")

  // Optional company leader: a regular STUDENT member granted two extra
  // capabilities — invite new members and view a team progress report.
  // Set/unset by tenant admins.
  leaderId String? @unique @map("leader_id")
  leader   User?   @relation("CompanyLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  // ── DC-3: datos del patrón ────────────────────────────────────────
  // Bloque azul del formato oficial. Los captura y confirma el líder de
  // proyecto de la empresa, y se reutilizan en todos los DC-3 de sus
  // miembros. Se guardan aquí (y no en cada constancia) precisamente
  // para no volver a pedirlos; cada DC-3 emitido conserva su propia
  // copia congelada, así que corregirlos aquí no reescribe los ya
  // impresos.
  //
  // `dc3LegalName` puede diferir de `name`: el formato pide la razón
  // social, y la empresa suele estar dada de alta con su nombre
  // comercial. Si está vacío se cae a `name`.
  dc3LegalName      String?   @map("dc3_legal_name")
  dc3Rfc            String?   @map("dc3_rfc")
  /// Patrón o representante legal (nota 4 del formato).
  dc3LegalRepName   String?   @map("dc3_legal_rep_name")
  /// Representante de los trabajadores. Sólo aplica a empresas de más de
  /// 50 trabajadores (nota 5), por eso es opcional.
  dc3WorkersRepName String?   @map("dc3_workers_rep_name")
  dc3ConfirmedAt    DateTime? @map("dc3_confirmed_at")

  dc3ConfirmedById String? @map("dc3_confirmed_by_id")
  dc3ConfirmedBy   User?   @relation("CompanyDc3ConfirmedBy", fields: [dc3ConfirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members                 User[]
  invitations             CompanyInvitation[]
  courseAssignments       CompanyCourseAssignment[]
  advisorySessions        AdvisorySession[]
  evaluationAssignments   EvaluationAssignment[]
  surveysAssigned         Survey[]                  @relation("SurveysForCompany")
  surveyCampaigns         SurveyCampaign[]          @relation("SurveyCampaignCompany")
  surveyResponsesReceived SurveyResponse[]          @relation("SurveyRespondentCompany")
  dc3Certificates         Dc3Certificate[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("companies")
}

/// Pending invitation for a user to join a company.
model CompanyInvitation {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email     String
  invitedBy String @map("invited_by")
  inviter   User   @relation("InvitationsSent", fields: [invitedBy], references: [id], onDelete: Cascade)

  token  String           @unique
  status InvitationStatus @default(PENDING)

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("company_invitations")
}

/// Assignment of a course to a company. Members of the company gain
/// the ability to enroll in the course without paying.
model CompanyCourseAssignment {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assignedBy String @map("assigned_by")
  assigner   User   @relation("AssignmentsMade", fields: [assignedBy], references: [id], onDelete: Cascade)

  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")

  @@unique([companyId, courseId])
  @@index([companyId])
  @@index([courseId])
  @@index([isActive])
  @@map("company_course_assignments")
}

/// Immutable audit trail for compliance and debugging.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String
  entity    String
  entityId  String  @map("entity_id")
  metadata  Json?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// In-app notification for users.
model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  link    String?

  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tenantId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Tracks async AI generation jobs for content creation.
model AIGenerationJob {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AIJobType
  status      AIJobStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  entityType  String?     @map("entity_type")
  entityId    String?     @map("entity_id")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("ai_generation_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Course Builder — multi-step course draft generation
// ─────────────────────────────────────────────────────────────────────────────

/// Draft of a course being built through the 4-step AI flow
/// (briefing → refinement → generation → editing). Persists between sessions.
/// When accepted, spawns a real Course and gets marked PUBLISHED.
model CourseDraft {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  professorId String @map("professor_id")
  professor   User   @relation(fields: [professorId], references: [id], onDelete: Cascade)

  status CourseDraftStatus @default(BRIEFING)

  // Step 1: briefing
  topic            String
  audience         String
  level            String @default("intermediate")
  moduleCount      Int    @map("module_count")
  lessonsPerModule Int    @map("lessons_per_module")
  language         String @default("es")

  // Step 2: refinement — { inferences: {...}, userAnswers: {...}, warnings: [...] }
  refinement Json?

  // Step 3: generated outline (see CourseOutlineV2 type in app code)
  outline       Json?
  outlineModel  String? @map("outline_model")
  outlineTokens Int?    @map("outline_tokens")

  // Cumulative cost in USD cents (for internal billing + quota enforcement)
  totalCostCents  Int @default(0) @map("total_cost_cents")
  creditsConsumed Int @default(0) @map("credits_consumed")

  // Link to the real Course spawned on acceptance
  publishedCourseId String? @unique @map("published_course_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  versions   CourseDraftVersion[]
  operations CourseDraftOperation[]

  @@index([tenantId])
  @@index([professorId])
  @@index([status])
  @@index([tenantId, status])
  @@map("course_drafts")
}

/// Immutable snapshot of a draft outline at a point in time. Enables rollback.
model CourseDraftVersion {
  id      String      @id @default(cuid())
  draftId String      @map("draft_id")
  draft   CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  version  Int
  snapshot Json
  reason   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([draftId, version])
  @@index([draftId])
  @@map("course_draft_versions")
}

/// Per-operation log for audit, analytics, and cost tracking.
model CourseDraftOperation {
  id      String      @id @default(cuid())
  draftId String      @map("draft_id")
  draft   CourseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  type       DraftOperationType
  target     String?
  input      Json?
  output     Json?
  model      String?
  tokensIn   Int?               @map("tokens_in")
  tokensOut  Int?               @map("tokens_out")
  costCents  Int?               @map("cost_cents")
  credits    Int?
  durationMs Int?               @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([draftId])
  @@index([type])
  @@index([createdAt])
  @@map("course_draft_operations")
}

/// Append-only ledger of AI credit movements per tenant. Positive = grant,
/// negative = consumption. Source of truth for billing; Tenant.aiCreditsBalance
/// is a cached sum maintained transactionally alongside this table.
model AICreditsLedger {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  delta   Int
  reason  String
  balance Int

  draftId         String? @map("draft_id")
  operationId     String? @map("operation_id")
  stripePaymentId String? @map("stripe_payment_id")

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([draftId])
  @@map("ai_credits_ledger")
}

// ─────────────────────────────────────────────────────────────────────────────
// Evaluations (DAFO-style assessments)
// ─────────────────────────────────────────────────────────────────────────────

/// Template for a recurring assessment (e.g. SWOT/DAFO). Authored by a
/// professor or tenant admin. Assigned to one or more companies; inside
/// each company, the leader designates which members must answer.
model Evaluation {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String @map("created_by")
  createdBy   User   @relation("EvaluationAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  title       String
  description String?
  methodology String?
  status      EvaluationStatus @default(DRAFT)
  kind        EvaluationKind   @default(DAFO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections    EvaluationSection[]
  assignments EvaluationAssignment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("evaluations")
}

/// A section inside an evaluation template. Determines how positive vs.
/// negative answers are interpreted in the consolidated report
/// (INTERNAL → Fortaleza/Debilidad, EXTERNAL → Oportunidad/Amenaza).
model EvaluationSection {
  id           String     @id @default(cuid())
  evaluationId String     @map("evaluation_id")
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  title    String
  type     EvaluationSectionType
  position Int                   @default(0)

  questions EvaluationQuestion[]

  @@index([evaluationId])
  @@map("evaluation_sections")
}

/// A single question inside a section.
model EvaluationQuestion {
  id        String            @id @default(cuid())
  sectionId String            @map("section_id")
  section   EvaluationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  code        String? // e.g. "1.1"
  label       String
  description String?
  position    Int                    @default(0)
  // MULTIPLE_CHOICE → Fortaleza/Debilidad/No aplica (counts toward DAFO).
  // OPEN_TEXT      → free text answer (does not count in the consolidated DAFO).
  // MULTI_FACTOR   → multi-selección F/D/O/A.
  // MULTI_SELECT   → respondent picks N options from `options` (JSON array of strings).
  type        EvaluationQuestionType @default(MULTIPLE_CHOICE)

  // MULTI_SELECT only: JSON array of strings the respondent picks from.
  // Null/empty for the other types. The respondent's answer references
  // these by index in `EvaluationAnswer.selectedOptionIndexes`.
  options Json?

  // MULTI_SELECT only: min/max number of selections the respondent must
  // pick. Both null means "any non-empty selection is OK". Both set to
  // the same value enforces "exactly N" (e.g. "selecciona CINCO").
  minSelections Int? @map("min_selections")
  maxSelections Int? @map("max_selections")

  // When true, MULTIPLE_CHOICE questions also expose the "No aplica"
  // option to the respondent (NOT_APPLICABLE value). Off by default
  // because most diagnostic questions force a Sí/Parcial/No answer;
  // turn it on per-question when a control may legitimately not apply.
  allowNotApplicable Boolean @default(false) @map("allow_not_applicable")

  answers EvaluationAnswer[]

  @@index([sectionId])
  @@map("evaluation_questions")
}

/// Assignment of an evaluation template to a specific company. The
/// assignedBy user is the professor/admin who published it for that company.
model EvaluationAssignment {
  id           String     @id @default(cuid())
  evaluationId String     @map("evaluation_id")
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedById String @map("assigned_by")
  assignedBy   User   @relation("EvaluationAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now()) @map("assigned_at")

  participants EvaluationParticipant[]

  @@unique([evaluationId, companyId])
  @@index([evaluationId])
  @@index([companyId])
  @@map("evaluation_assignments")
}

/// A specific user who must answer a given assignment. Initially the
/// company's leader(s) are added automatically; the leader can later add
/// other members from the team.
model EvaluationParticipant {
  id           String               @id @default(cuid())
  assignmentId String               @map("assignment_id")
  assignment   EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("EvaluationParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  addedById String   @map("added_by")
  addedBy   User     @relation("EvaluationParticipantAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt   DateTime @default(now()) @map("added_at")

  submissions EvaluationSubmission[]

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
  @@map("evaluation_participants")
}

/// One complete submission of answers by a participant. Every time the
/// participant hits "Enviar" we create a new row (incrementing version);
/// the latest submission is what counts for consolidated reports.
model EvaluationSubmission {
  id            String                @id @default(cuid())
  participantId String                @map("participant_id")
  participant   EvaluationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  submittedById String @map("submitted_by")
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  version     Int      @default(1)
  submittedAt DateTime @default(now()) @map("submitted_at")

  answers EvaluationAnswer[]

  @@unique([participantId, version])
  @@index([participantId])
  @@map("evaluation_submissions")
}

/// A single answer to one question inside a submission.
model EvaluationAnswer {
  id           String               @id @default(cuid())
  submissionId String               @map("submission_id")
  submission   EvaluationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String             @map("question_id")
  question   EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Mutually-exclusive depending on the question type:
  //  - MULTIPLE_CHOICE → `value` is set (POSITIVE/PARTIAL/NEGATIVE/NOT_APPLICABLE).
  //  - OPEN_TEXT       → `text` is set, free-form participant response.
  //  - MULTI_FACTOR    → `factors` carries one or more F/D/O/A.
  //  - MULTI_SELECT    → `selectedOptionIndexes` carries the indices (into
  //                       EvaluationQuestion.options) the respondent picked.
  value                 EvaluationAnswerValue?
  text                  String?
  factors               EvaluationFactor[]     @default([])
  selectedOptionIndexes Int[]                  @default([]) @map("selected_option_indexes")

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@map("evaluation_answers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Surveys (encuestas) — herramienta de evaluacion de satisfaccion, activada
// con `Tenant.surveysEnabled`.
//
// El modulo lo administra EXCLUSIVAMENTE el administrador del tenant
// (ADMIN / SUPER_ADMIN). Los usuarios cliente (STUDENT, incluido el lider de
// una empresa) solo responden lo que se les asigna y, cuando el
// administrador lo aprueba, consultan el resultado consolidado.
//
// Estructura en dos niveles:
//   Survey          → la PLANTILLA (cuestionario reutilizable del tenant).
//   SurveyCampaign  → un LANZAMIENTO de esa plantilla: a que empresa/curso/
//                     proyecto va, cuando abre y cierra, a quien se manda y
//                     hasta donde llegan sus resultados.
//   SurveyRecipient → cada destinatario del lanzamiento, con su enlace unico.
//
// Separarlos es lo que permite lanzar la misma encuesta por bloques (una
// campaña por curso/etapa/empresa) sin duplicar el cuestionario, y agregar
// resultados por encuesta, curso, empresa o periodo.
// ─────────────────────────────────────────────────────────────────────────────

/// Plantilla de encuesta. `publicSlug` sobrevive del diseño anterior para no
/// romper enlaces ya repartidos; el flujo vigente reparte enlaces por
/// destinatario (`SurveyRecipient.token`), no por slug de encuesta.
model Survey {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Autor: siempre un administrador del tenant. El nombre de la columna es
  // herencia del diseño anterior (cuando la creaba un profesor) y se
  // conserva para no reescribir datos existentes.
  professorId String @map("professor_id")
  professor   User   @relation("SurveysCreated", fields: [professorId], references: [id], onDelete: Cascade)

  // Empresa sugerida por defecto al lanzar. Opcional: una plantilla puede
  // servir a varias empresas, y la empresa real de cada envio vive en la
  // campaña.
  companyId String?  @map("company_id")
  company   Company? @relation("SurveysForCompany", fields: [companyId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text

  publicSlug String       @unique @map("public_slug")
  status     SurveyStatus @default(DRAFT)

  resultsShareToken String? @unique @map("results_share_token")

  /// Duracion sugerida (dias) que se precarga al crear un lanzamiento.
  defaultDurationDays Int @default(30) @map("default_duration_days")

  /// Dias antes del cierre en los que sale un recordatorio automatico.
  defaultReminderDays Int[] @default([7, 2]) @map("default_reminder_days")

  /// Disparador automatico. COURSE_COMPLETED lanza la encuesta cuando el
  /// alumno termina el curso indicado; CERTIFICATE_ISSUED cuando se emite su
  /// diploma. MANUAL no dispara nada.
  trigger         SurveyTrigger @default(MANUAL)
  triggerCourseId String?       @map("trigger_course_id")
  triggerCourse   Course?       @relation("SurveyTriggerCourse", fields: [triggerCourseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions SurveyQuestion[]
  responses SurveyResponse[]
  campaigns SurveyCampaign[]

  @@index([tenantId])
  @@index([companyId])
  @@index([professorId])
  @@index([tenantId, status])
  @@index([trigger, triggerCourseId])
  @@map("surveys")
}

/// One question of a survey. `options` is a JSON array of strings used
/// only when `type = MULTIPLE_CHOICE`; ignored for `RATING_STARS` (1-5).
model SurveyQuestion {
  id       String @id @default(cuid())
  surveyId String @map("survey_id")
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  type     SurveyQuestionType
  label    String
  position Int
  options  Json?

  /// Seccion a la que pertenece la pregunta ("Contenido", "Instructor"...).
  /// Es texto libre en vez de tabla aparte: agrupa las metricas del informe
  /// sin obligar al administrador a mantener un catalogo de secciones.
  section String?

  /// Peso relativo dentro del indice de satisfaccion. 0 excluye la pregunta
  /// del indice (util para preguntas de clasificacion, no de satisfaccion).
  weight Float @default(1)

  /// Solo SCALE_LABELED: ofrece ademas "No aplica". Marcarlo NO penaliza —
  /// la respuesta se cuenta aparte y queda fuera del promedio, que es como
  /// funciona el "NA" del formulario en papel.
  allowNotApplicable Boolean @default(false) @map("allow_not_applicable")

  createdAt DateTime @default(now()) @map("created_at")

  answers SurveyAnswer[]

  @@index([surveyId, position])
  @@map("survey_questions")
}

/// Lanzamiento de una encuesta: contexto, ventana de respuesta,
/// destinatarios y visibilidad del resultado consolidado.
model SurveyCampaign {
  id       String @id @default(cuid())
  surveyId String @map("survey_id")
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String @map("created_by")
  createdBy   User   @relation("SurveyCampaignsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  name String

  audience SurveyAudienceKind @default(COMPANY_ALL)

  // Contexto que se muestra al destinatario en el correo y en su panel.
  companyId String?  @map("company_id")
  company   Company? @relation("SurveyCampaignCompany", fields: [companyId], references: [id], onDelete: Cascade)

  courseId String? @map("course_id")
  course   Course? @relation("SurveyCampaignCourse", fields: [courseId], references: [id], onDelete: SetNull)

  workshopId String?   @map("workshop_id")
  workshop   Workshop? @relation("SurveyCampaignWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)

  advisorySessionId String?          @map("advisory_session_id")
  advisorySession   AdvisorySession? @relation("SurveyCampaignAdvisory", fields: [advisorySessionId], references: [id], onDelete: SetNull)

  /// Proyecto, evento o etapa cuando no hay una entidad en la plataforma que
  /// referenciar (p. ej. "Proyecto Planta Norte — etapa 2").
  projectLabel String? @map("project_label")

  opensAt  DateTime @default(now()) @map("opens_at")
  closesAt DateTime @map("closes_at")

  /// Dias antes del cierre en los que sale cada recordatorio.
  reminderDaysBefore Int[] @default([7, 2]) @map("reminder_days_before")

  status   SurveyCampaignStatus @default(DRAFT)
  sentAt   DateTime?            @map("sent_at")
  closedAt DateTime?            @map("closed_at")

  /// Enlace compartible (opcional) para casos donde no todos los asistentes
  /// son usuarios de la plataforma. Se identifica por correo y genera un
  /// destinatario al vuelo, asi que sigue sujeto a vencimiento y a una sola
  /// respuesta por persona.
  shareToken String? @unique @map("share_token")

  /// Enlace de solo lectura del consolidado. Solo sirve si el administrador
  /// ya aprobo la publicacion.
  resultsShareToken String? @unique @map("results_share_token")

  // Aprobacion de la publicacion del consolidado.
  resultsAudience      SurveyResultsAudience @default(NONE) @map("results_audience")
  resultsPublishedAt   DateTime?             @map("results_published_at")
  resultsPublishedById String?               @map("results_published_by")
  resultsPublishedBy   User?                 @relation("SurveyResultsPublisher", fields: [resultsPublishedById], references: [id], onDelete: SetNull)
  resultsNote          String?               @map("results_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipients SurveyRecipient[]
  responses  SurveyResponse[]

  @@index([surveyId])
  @@index([tenantId])
  @@index([companyId])
  @@index([courseId])
  @@index([status, closesAt])
  @@index([tenantId, status])
  @@map("survey_campaigns")
}

/// Destinatario de un lanzamiento. `token` es el enlace unico y personal:
/// solo sirve para responder ESTE lanzamiento y no da acceso a nada mas.
model SurveyRecipient {
  id         String         @id @default(cuid())
  campaignId String         @map("campaign_id")
  campaign   SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Usuario de la plataforma cuando el destinatario tiene cuenta. Los
  // destinatarios que llegan por enlace compartible no tienen userId.
  userId String? @map("user_id")
  user   User?   @relation("SurveyRecipientUser", fields: [userId], references: [id], onDelete: SetNull)

  email String
  name  String?

  token String @unique

  status SurveyRecipientStatus @default(PENDING)

  sentAt         DateTime? @map("sent_at")
  lastRemindedAt DateTime? @map("last_reminded_at")
  remindersSent  Int       @default(0) @map("reminders_sent")
  respondedAt    DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")

  response SurveyResponse?

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@map("survey_recipients")
}

/// Envio completo de un respondiente. Cada respuesta pertenece a un
/// lanzamiento y a un destinatario; las filas con `campaignId` nulo son del
/// diseño anterior (enlace publico abierto) y se conservan solo para el
/// historico.
model SurveyResponse {
  id       String @id @default(cuid())
  surveyId String @map("survey_id")
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  campaignId String?         @map("campaign_id")
  campaign   SurveyCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  recipientId String?          @unique @map("recipient_id")
  recipient   SurveyRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  email String

  respondentCompanyId   String?  @map("respondent_company_id")
  respondentCompany     Company? @relation("SurveyRespondentCompany", fields: [respondentCompanyId], references: [id], onDelete: SetNull)
  respondentCompanyName String?  @map("respondent_company_name")

  submittedAt DateTime @default(now()) @map("submitted_at")

  answers SurveyAnswer[]

  // Una respuesta por persona y por lanzamiento. La unicidad ya no es por
  // encuesta: la misma plantilla se relanza por bloques y la misma persona
  // debe poder responder cada lanzamiento.
  @@unique([campaignId, email])
  @@index([surveyId])
  @@index([campaignId])
  @@index([respondentCompanyId])
  @@map("survey_responses")
}

/// Per-question answer. Exactly one of `ratingValue` / `selectedOptionIndex`
/// is non-null based on the parent question type — enforced at the
/// application layer (Prisma can't model "exactly one of").
model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String         @map("response_id")
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String         @map("question_id")
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Exactamente uno segun el tipo de la pregunta padre:
  //   RATING_STARS                 -> ratingValue
  //   MULTIPLE_CHOICE/SCALE_LABELED-> selectedOptionIndex (o notApplicable)
  //   OPEN_TEXT                    -> text
  ratingValue         Int? @map("rating_value")
  selectedOptionIndex Int? @map("selected_option_index")

  /// Respuesta de texto libre. Es dato individual: nunca se publica al
  /// cliente, solo la ve el administrador.
  text String? @db.Text

  /// El respondiente marco "No aplica". Se guarda aparte de
  /// `selectedOptionIndex` para no inventar un indice que no eligio.
  notApplicable Boolean @default(false) @map("not_applicable")

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("survey_answers")
}
