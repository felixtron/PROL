[Unit]
Description=prol-db
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=prol-db
Image=pgvector/pgvector:pg16
Pull=never
Network=prol-internal.network:alias=db
Volume=prol_db_data:/var/lib/postgresql/data
EnvironmentFile=/etc/containers/env/prol-db.env
# OJO: usuario y base van escritos aquí, no salen del EnvironmentFile. Al
# renombrar la base hay que cambiarlos también o la unit queda `unhealthy`
# sin que nada esté roto de verdad.
HealthCmd="pg_isready -U prol -d prol"
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
