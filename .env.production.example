# ─────────────────────────────────────────────────────────────────────────────
# PROL - Production environment variables
# Copy to .env on the VPS and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# --- App URL & Domain ---
# Sin prefijo `NEXT_PUBLIC_` a proposito: esas variables se INLINAN en el bundle
# durante el build, asi que congelarian el dominio dentro de la imagen y una
# misma imagen no podria servir a dos instancias. La aplicacion lee estas y solo
# cae a las `NEXT_PUBLIC_*` si faltan.
APP_URL="https://prol.prosuite.pro"
APP_DOMAIN="prol.prosuite.pro"
# Same domain but with dots escaped (for Traefik regex). Example:
#   APP_DOMAIN=prol.prosuite.pro -> APP_DOMAIN_REGEX=prol\.prosuite\.pro
APP_DOMAIN_REGEX="prol\\.prosuite\\.pro"

# --- Identidad de la instancia ---
# Todo esto tiene por defecto el valor historico de PROL: dejarlo vacio o sin
# definir hace que la aplicacion se comporte exactamente como siempre. Una
# instalacion dedicada es la que los cambia.
#
# Vacia = valor por defecto, EXCEPTO POWERED_BY_NAME (ver abajo).
#
# BRAND_NAME          Nombre en pestanas, panel y pantallas de acceso.
# BRAND_TAGLINE       Complemento del <title> de la portada.
# BRAND_DESCRIPTION   Meta description del sitio.
# SUPPORT_EMAIL       Buzon que ofrece la base de conocimientos.
# POWERED_BY_ENABLED  Pie "Powered by" del login. Ponlo en "false" para
#                     ocultarlo (lo que quiere una instalacion dedicada).
#                     Cualquier otra cosa, incluida vacia, lo muestra.
# POWERED_BY_NAME     Marca de ese pie.
# POWERED_BY_URL      Enlace de ese pie.
BRAND_NAME=""
BRAND_TAGLINE=""
BRAND_DESCRIPTION=""
SUPPORT_EMAIL=""
POWERED_BY_ENABLED=""
POWERED_BY_NAME=""
POWERED_BY_URL=""

# Instancia dedicada a un solo tenant: el dominio apex ES ese tenant, sin
# subdominio. Vacia = modo multi-tenant por subdominio (el de siempre).
DEFAULT_TENANT_SLUG=""

# --- Correo ---
# EMAIL_FROM_NAME  Nombre del remitente. Por defecto "PROL".
# EMAIL_REPLY_TO   Buzon real al que van las respuestas. SIN valor por defecto:
#                  sin el, las respuestas se pierden en noreply@ (lo de hoy).
EMAIL_FROM_NAME=""
EMAIL_REPLY_TO=""

# --- Database (used by docker-compose.prod.yml) ---
DB_USER="prol"
DB_PASSWORD="change_me_in_production"
DB_NAME="prol"

# --- Better Auth ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cloudflare Stream (video hosting, optional) ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# --- Email (Resend) ---
RESEND_API_KEY=""
RESEND_DOMAIN=""

# --- AI Module (optional - module 6) ---
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""
TRIGGER_SECRET_KEY=""

# --- Google Meet (opcional) ---
# Redirect URI autorizado en Google Cloud Console:
#   https://prol.prosuite.pro/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Barrido programado de encuestas (recordatorios y cierre por vencimiento) y de
# actividades de cumplimiento. Lo dispara el cron del host contra
# /api/cron/surveys y /api/cron/compliance (ver DEPLOY.md).
# Sin este valor las rutas responden 503 en vez de quedar abiertas.
CRON_SECRET=""

# Evidencias y plantillas por empresa del módulo de gestión documental.
# Apunta a un volumen persistente FUERA de public/uploads: esos archivos sólo
# pueden salir por /files/*, que autoriza contra la base, y public/ lo sirve
# Next sin comprobar sesión.
PRIVATE_UPLOAD_DIR="/app/private-uploads"

# Cloudflare R2 (tier confidencial). Las cuatro juntas o ninguna.
# Vacías = disco (PRIVATE_UPLOAD_DIR). Bucket COMPARTIDO con otro producto:
# PROL sólo escribe bajo `prol/`. NUNCA commitear valores reales.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Prefijo dentro del bucket. Por defecto "prol/". Cada instancia escribe bajo el
# suyo y no ve los archivos de las demas. CAMBIARLO NO MUEVE NADA: los objetos
# hay que copiarlos antes, o la instancia dejara de encontrar sus archivos.
R2_KEY_PREFIX=""
